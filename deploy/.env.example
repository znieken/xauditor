# deploy/.env.example
#
# Copy this file to `deploy/.env` and edit before the first
# `docker compose up -d`. Every value below is env-driven by compose.yaml.
#
#   cp deploy/.env.example deploy/.env
#   chmod 600 deploy/.env
#   $EDITOR deploy/.env
#
# `deploy/.env` is gitignored — never commit real passwords.

# -----------------------------------------------------------------------------
# Neo4j (graph store)
# -----------------------------------------------------------------------------

NEO4J_IMAGE=neo4j:5-community
NEO4J_USER=neo4j
# REQUIRED — no default. Compose will refuse to start if this is unset.
NEO4J_PASSWORD=

# Bolt (client driver) and HTTP (browser UI) ports on the host.
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474

# Bind address for the two Neo4j ports above.
#   0.0.0.0  -> reachable from the public internet (default; use only behind a
#               VPN or firewall, and rotate NEO4J_PASSWORD before first boot)
#   127.0.0.1 -> loopback only (tunnel via SSH / reverse proxy)
NEO4J_BIND_ADDR=0.0.0.0

# -----------------------------------------------------------------------------
# Report database (Postgres)
# -----------------------------------------------------------------------------

REPORTDB_IMAGE=postgres:16-alpine
REPORTDB_USER=xauditor
# REQUIRED — no default. Compose will refuse to start if this is unset.
REPORTDB_PASSWORD=
REPORTDB_DATABASE=xauditor_reportdb
REPORTDB_PORT=5432
REPORTDB_BIND_ADDR=0.0.0.0

# -----------------------------------------------------------------------------
# Portal (frontend + backend)
# -----------------------------------------------------------------------------

# REQUIRED — exact filename of the xauditor-portal wheel to build the
# backend and frontend images from. The wheel MUST live in
# `deploy/packages/` (which is also served by the pypi container). Update
# this when you publish a new portal version and `docker compose up -d
# --build` to rebuild the containers against the new wheel.
#
# Example: xauditor_portal-0.2.3-py3-none-any.whl
PORTAL_WHEEL=

# Defaults rebuild locally from PORTAL_WHEEL. Set these to registry-hosted
# tags (e.g. `ghcr.io/your-org/xauditor-portal-backend:0.2.3`) to pull
# pre-built images and skip the local build step.
PORTAL_BACKEND_IMAGE=xauditor-portal-backend:local
PORTAL_FRONTEND_IMAGE=xauditor-portal-frontend:local

# Host-side port for the web UI (the only portal port actually published).
PORTAL_HOST_PORT=8080
PORTAL_BIND_ADDR=0.0.0.0

# -----------------------------------------------------------------------------
# Internal PyPI index (for analyst `pip install`)
# -----------------------------------------------------------------------------

PYPI_IMAGE=pypiserver/pypiserver:v2.1.1

# The pypi container bind-mounts `./packages` (fixed path — not configurable)
# so the same directory feeds both the PyPI index AND the Docker build
# context for the portal containers. Drop xauditor / xauditor-portal
# `.whl` + `.tar.gz` files into `deploy/packages/` to publish them.

PYPI_HOST_PORT=8081
# Anonymous read is enabled by default so analysts can `pip install` without
# credentials. If exposed to the public internet, front the service with a
# VPN or an auth-terminating reverse proxy (see deploy/README.md).
PYPI_BIND_ADDR=0.0.0.0

# -----------------------------------------------------------------------------
# Install-script HTTP server (for analyst `curl | bash`)
# -----------------------------------------------------------------------------

INSTALL_IMAGE=nginx:1.27-alpine

# Host-side directory bind-mounted read-only into the container. Edit or
# replace the shipped `deploy/install/install.sh` to suit your rollout.
INSTALL_DATA_DIR=./install

INSTALL_HOST_PORT=8082
INSTALL_BIND_ADDR=0.0.0.0
